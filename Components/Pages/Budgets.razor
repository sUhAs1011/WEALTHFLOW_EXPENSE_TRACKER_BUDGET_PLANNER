@page "/budgets"
@using C__Project.Models
@using C__Project.Services
@inject CategoryService CategoryService

<PageTitle>WealthFlow — Budgets & Categories</PageTitle>

<div class="toast-container">
    @foreach (var toast in toasts)
    {
        <div class="toast-custom toast-@toast.Type">
            <span>@(toast.Type == "success" ? "✅" : toast.Type == "danger" ? "❌" : "⚠️")</span>
            <span class="toast-message">@toast.Message</span>
        </div>
    }
</div>

<div class="fade-in">
    <div class="mb-4">
        <h1 class="mb-1 text-white">Budgets & Categories</h1>
        <p class="text-secondary">Set monthly limits for your expense sectors and customize your categories</p>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left Side: Budgets Setup -->
            <div class="col-12 col-lg-7">
                <div class="glass-card">
                    <h3 class="mb-4 text-white">Set Monthly Limits</h3>
                    <p class="text-secondary" style="font-size: 0.9rem;">
                        Establish targets for <strong>@DateTime.Today.ToString("MMMM yyyy")</strong>. 
                        Enter `0` or leave empty to disable the budget for that category.
                    </p>

                    <div class="d-flex flex-column gap-3 mt-4">
                        @foreach (var budgetModel in budgetForms)
                        {
                            <div class="p-3 rounded-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-light);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: @(budgetModel.Color + "15"); color: @budgetModel.Color; font-size: 1.2rem; border: 1px solid @(budgetModel.Color + "30");">
                                        @budgetModel.Icon
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-white font-weight-bold">@budgetModel.CategoryName</h6>
                                        <span class="text-secondary" style="font-size: 0.75rem;">
                                            @(budgetModel.HasBudget ? $"Current limit: ${budgetModel.Amount:N0}" : "No budget configured")
                                        </span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group input-group-sm" style="width: 160px;">
                                        <span class="input-group-text bg-dark border-secondary text-secondary">$</span>
                                        <input type="number" class="form-control form-control-sm" placeholder="Limit" @bind="budgetModel.Amount" min="0" />
                                    </div>
                                    <button class="btn btn-action btn-edit btn-sm" @onclick="() => SaveBudget(budgetModel)">Save</button>
                                    @if (budgetModel.HasBudget)
                                    {
                                        <button class="btn btn-action btn-delete btn-sm" @onclick="() => DeleteBudget(budgetModel)" title="Delete Budget">✕</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Side: Categories Manager -->
            <div class="col-12 col-lg-5">
                <!-- Create Category Card -->
                <div class="glass-card mb-4">
                    <h3 class="mb-4 text-white">Create Category</h3>
                    
                    <EditForm Model="newCategory" OnValidSubmit="CreateCategory">
                        <DataAnnotationsValidator />
                        
                        <div class="d-flex flex-column gap-3">
                            <!-- Name -->
                            <div>
                                <label class="form-label">Category Name</label>
                                <InputText @bind-Value="newCategory.Name" class="form-control" placeholder="e.g. Health & Fitness" />
                                <ValidationMessage For="() => newCategory.Name" class="text-danger mt-1" style="font-size: 0.8rem;" />
                            </div>

                            <div class="row g-3">
                                <!-- Icon / Emoji selection -->
                                <div class="col-6">
                                    <label class="form-label">Icon (Emoji)</label>
                                    <InputSelect @bind-Value="newCategory.Icon" class="form-select">
                                        <optgroup label="General">
                                            <option value="📁">📁 Other / General</option>
                                            <option value="🎁">🎁 Gifts & Donation</option>
                                            <option value="❤️">❤️ Charity / Love</option>
                                            <option value="🧸">🧸 Toys & Kids</option>
                                        </optgroup>
                                        <optgroup label="Food & Dining">
                                            <option value="🍔">🍔 Restaurants & Fast Food</option>
                                            <option value="🍎">🍎 Groceries</option>
                                            <option value="☕">☕ Coffee & Cafe</option>
                                            <option value="🍕">🍕 Pizza & Delivery</option>
                                            <option value="🍺">🍺 Drinks & Nightlife</option>
                                        </optgroup>
                                        <optgroup label="Transport & Travel">
                                            <option value="🚗">🚗 Car & Vehicle</option>
                                            <option value="⛽">⛽ Gas & Fuel</option>
                                            <option value="🚕">🚕 Taxi & Uber</option>
                                            <option value="✈️">✈️ Travel & Flights</option>
                                            <option value="🚆">🚆 Public Transport</option>
                                        </optgroup>
                                        <optgroup label="Home & Bills">
                                            <option value="🏠">🏠 Rent & Mortgage</option>
                                            <option value="⚡">⚡ Utilities & Electricity</option>
                                            <option value="🔌">🔌 Gas & Water</option>
                                            <option value="🌐">🌐 Internet & Phone</option>
                                            <option value="🛋️">🛋️ Furniture & Deco</option>
                                            <option value="🧹">🧹 Cleaning & Services</option>
                                        </optgroup>
                                        <optgroup label="Entertainment & Play">
                                            <option value="🎬">🎬 Movies & Cinema</option>
                                            <option value="🎮">🎮 Gaming & Tech</option>
                                            <option value="🎤">🎤 Concerts & Shows</option>
                                            <option value="🎫">🎫 Tickets & Events</option>
                                            <option value="⚽">⚽ Sports & Hobbies</option>
                                        </optgroup>
                                        <optgroup label="Shopping & Style">
                                            <option value="🛍️">🛍️ Shopping & Stores</option>
                                            <option value="👕">👕 Clothing & Apparel</option>
                                            <option value="👟">👟 Shoes & Gear</option>
                                            <option value="💄">💄 Cosmetics & Beauty</option>
                                            <option value="📱">📱 Gadgets & Electronics</option>
                                        </optgroup>
                                        <optgroup label="Health & Personal">
                                            <option value="🥗">🥗 Health & Wellness</option>
                                            <option value="🏋️">🏋️ Fitness & Gym</option>
                                            <option value="💊">💊 Medicine & Pharmacy</option>
                                            <option value="🩺">🩺 Doctor & Clinic</option>
                                            <option value="💇">💇 Self Care & Haircut</option>
                                            <option value="🐶">🐶 Pets & Veterinary</option>
                                        </optgroup>
                                        <optgroup label="Finance & Education">
                                            <option value="📈">📈 Investments & Shares</option>
                                            <option value="🏢">🏢 Office & Work</option>
                                            <option value="🏫">🏫 Education & Courses</option>
                                            <option value="📚">📚 Books & Stationery</option>
                                        </optgroup>
                                    </InputSelect>
                                    <ValidationMessage For="() => newCategory.Icon" class="text-danger mt-1" style="font-size: 0.8rem;" />
                                </div>

                                 <!-- Theme Color -->
                                 <div class="col-12 mt-2">
                                     <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-light);">
                                         <div class="position-relative rounded-circle d-flex align-items-center justify-content-center" 
                                              style="width: 52px; height: 52px; background-color: @categoryColorHex; border: 2px solid white; cursor: pointer; transition: transform 0.2s;"
                                              onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                             <input type="color" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" @bind="categoryColorHex" />
                                             <span style="font-size: 1.25rem;">🎨</span>
                                         </div>
                                         <div>
                                             <label class="form-label mb-0 text-white font-weight-bold d-block">Choose Category Color</label>
                                             <span class="text-secondary" style="font-size: 0.8rem;">Click the palette circle to choose any custom color</span>
                                         </div>
                                     </div>
                                 </div>
                            </div>

                            <button type="submit" class="btn btn-primary-custom w-100 mt-2">Add Category</button>
                        </div>
                    </EditForm>
                </div>

                <!-- Existing Categories List -->
                <div class="glass-card">
                    <h3 class="mb-4 text-white">Active Sectors</h3>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var cat in categories)
                        {
                            <span class="category-badge py-2 px-3 align-items-center" style="background-color: @(cat.Color + "15"); color: @cat.Color; border: 1px solid @(cat.Color + "30"); font-size: 0.9rem;">
                                <span>@cat.Icon</span>
                                <span class="text-white font-weight-bold ms-1">@cat.Name</span>
                                @if (cat.Id > 6) // Only allow deletion of user-added categories, not seeded base ones
                                {
                                    <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.65rem;" @onclick="() => DeleteCategory(cat.Id)"></button>
                                }
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private List<Category> categories = new();
    private List<BudgetModelForm> budgetForms = new();
    
    // New Category Form Models
    private Category newCategory = new() { Icon = "📁" };
    private string categoryColorHex = "#6366f1";

    // Toast Notifications State
    private List<ToastMessage> toasts = new();

    private async void ShowToast(string message, string type = "success")
    {
        var toast = new ToastMessage { Message = message, Type = type };
        toasts.Add(toast);
        StateHasChanged();
        
        // Auto-dismiss after 3.5 seconds safely on the UI synchronization context
        await Task.Delay(3500);
        
        toasts.Remove(toast);
        StateHasChanged();
    }

    private class ToastMessage
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Message { get; set; } = "";
        public string Type { get; set; } = "success";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            categories = await CategoryService.GetCategoriesAsync();
            
            var today = DateTime.Today;
            budgetForms = categories.Select(c => new BudgetModelForm
            {
                CategoryId = c.Id,
                CategoryName = c.Name,
                Icon = c.Icon,
                Color = c.Color,
                BudgetId = c.Budget?.Id ?? 0,
                Amount = c.Budget?.Amount ?? 0,
                HasBudget = c.Budget != null,
                Month = c.Budget?.Month ?? new DateTime(today.Year, today.Month, 1)
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading categories/budgets: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveBudget(BudgetModelForm form)
    {
        if (form.Amount < 0) return;

        var budget = new Budget
        {
            Id = form.BudgetId,
            CategoryId = form.CategoryId,
            Amount = form.Amount,
            Month = form.Month
        };

        bool result = await CategoryService.SaveBudgetAsync(budget);
        if (result)
        {
            ShowToast($"Budget for {form.CategoryName} saved successfully!");
            await LoadData();
        }
        else
        {
            ShowToast("Failed to save budget limit.", "danger");
        }
    }

    private async Task DeleteBudget(BudgetModelForm form)
    {
        if (form.BudgetId > 0)
        {
            bool result = await CategoryService.DeleteBudgetAsync(form.BudgetId);
            if (result)
            {
                ShowToast($"Budget for {form.CategoryName} removed.", "warning");
                await LoadData();
            }
            else
            {
                ShowToast("Failed to remove budget limit.", "danger");
            }
        }
    }

    private async Task CreateCategory()
    {
        newCategory.Color = categoryColorHex;
        var name = newCategory.Name;
        
        bool result = await CategoryService.SaveCategoryAsync(newCategory);
        if (result)
        {
            ShowToast($"Category '{name}' created successfully!");
            // Reset form
            newCategory = new Category { Icon = "📁" };
            categoryColorHex = "#6366f1";
            await LoadData();
        }
        else
        {
            ShowToast("Failed to create category.", "danger");
        }
    }

    private async Task DeleteCategory(int id)
    {
        bool result = await CategoryService.DeleteCategoryAsync(id);
        if (result)
        {
            ShowToast("Category deleted.", "warning");
            await LoadData();
        }
        else
        {
            ShowToast("Failed to delete category.", "danger");
        }
    }

    // Helper model to simplify inline forms in Blazor
    private class BudgetModelForm
    {
        public int CategoryId { get; set; }
        public string CategoryName { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "";
        public int BudgetId { get; set; }
        public decimal Amount { get; set; }
        public bool HasBudget { get; set; }
        public DateTime Month { get; set; }
    }
}
