@page "/analytics"
@using C__Project.Models
@using C__Project.Services
@inject ExpenseService ExpenseService
@inject SpendForecasterService Forecaster
@inject FinancialAdvisorService Advisor

<PageTitle>WealthFlow — Analytics & AI Advisor</PageTitle>

<div class="fade-in">
    <div class="mb-4">
        <h1 class="mb-1 text-white">Analytics & AI Financial Advisor</h1>
        <p class="text-secondary">Visual analysis of spending distribution, regression trends, and personalized budget advice</p>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!categorySpends.Any())
    {
        <div class="glass-card text-center py-5">
            <div class="mb-3" style="font-size: 3rem;">📊</div>
            <h4 class="text-white">No expenses recorded for this month</h4>
            <p class="text-secondary">Please add transaction details to visualize analytics and financial advice.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <!-- Left Side: SVG Donut Chart -->
            <div class="col-12 col-md-5">
                <div class="glass-card text-center d-flex flex-column align-items-center justify-content-center h-100">
                    <h3 class="mb-4 text-white w-100 text-start">Expense Share</h3>
                    
                    <div class="chart-container-donut">
                        <svg width="220" height="220" viewBox="0 0 220 220" style="transform: rotate(-90deg);">
                            <circle cx="110" cy="110" r="70" fill="transparent" stroke="rgba(255,255,255,0.03)" stroke-width="24" />
                            
                            @{
                                double cumulativePercentage = 0;
                                foreach (var spend in categorySpends)
                                {
                                    var percentage = (double)(totalSpend > 0 ? spend.Amount / totalSpend : 0);
                                    var strokeLength = percentage * Circumference;
                                    var strokeGap = Circumference - strokeLength;
                                    var rotation = cumulativePercentage * 360;
                                    
                                    <circle cx="110" cy="110" r="70" 
                                            fill="transparent" 
                                            stroke="@spend.Color" 
                                            stroke-width="24" 
                                            stroke-dasharray="@($"{strokeLength.ToString("F2")} {strokeGap.ToString("F2")}")" 
                                            style="transform-origin: 110px 110px; transform: rotate(@(rotation.ToString("F2"))deg); transition: stroke-dasharray 0.5s ease-in-out;" />
                                    
                                    cumulativePercentage += percentage;
                                }
                            }
                        </svg>
                        <div class="chart-center-text">
                            <span class="text-secondary text-uppercase d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Spent</span>
                            <h3 class="mb-0 text-white font-weight-extrabold" style="font-size: 1.5rem;">$@totalSpend.ToString("N0")</h3>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2 w-100 mt-4 align-items-start px-2">
                        @foreach (var spend in categorySpends)
                        {
                            var pct = totalSpend > 0 ? (spend.Amount / totalSpend) * 100 : 0;
                            <div class="d-flex justify-content-between align-items-center w-100" style="font-size: 0.9rem;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-circle" style="width: 12px; height: 12px; background-color: @spend.Color; display: inline-block;"></span>
                                    <span class="text-white">@spend.Icon @spend.CategoryName</span>
                                </div>
                                <div class="text-end">
                                    <span class="text-white font-weight-bold">$@spend.Amount.ToString("N2")</span>
                                    <span class="text-secondary" style="font-size: 0.8rem; margin-left: 0.25rem;">(@pct.ToString("N1")%)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Side: Category Progress Bars & Distribution -->
            <div class="col-12 col-md-7">
                <div class="glass-card h-100">
                    <h3 class="mb-4 text-white">Sector Distribution</h3>
                    <p class="text-secondary mb-4" style="font-size: 0.9rem;">Visual overview of how your spending scales across categories.</p>

                    <div class="d-flex flex-column gap-4">
                        @foreach (var spend in categorySpends)
                        {
                            var pct = totalSpend > 0 ? (double)(spend.Amount / totalSpend) * 100 : 0;
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="category-badge" style="background-color: @(spend.Color + "20"); color: @spend.Color; border: 1px solid @(spend.Color + "35");">
                                            @spend.Icon @spend.CategoryName
                                        </span>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-white font-weight-bold">$@spend.Amount.ToString("N2")</span>
                                        <span class="text-secondary ms-1" style="font-size: 0.8rem;">(@pct.ToString("N1")%)</span>
                                    </div>
                                </div>
                                <div class="progress-bar-wrapper" style="height: 10px;">
                                    <div class="progress-bar-fill" 
                                         style="width: @pct%; background-color: @spend.Color; box-shadow: 0 0 10px @(spend.Color + "40");">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- AI Spending Trend & Horizon Forecast Section -->
        @if (forecastResult != null)
        {
            <div class="glass-card mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
                    <div>
                        <h3 class="mb-1 text-white d-flex align-items-center gap-2">
                            <span>📈</span> AI Spending Trend & @selectedForecastDays-Day Forecast
                        </h3>
                        <p class="text-secondary mb-0" style="font-size: 0.88rem;">
                            Predictive trajectory generated using Ordinary Least Squares (OLS) Linear Regression ($y = mx + c$).
                        </p>
                    </div>
                    
                    <!-- Horizon Selector Controls -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge" style="background-color: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-size: 0.78rem; padding: 6px 12px;">
                            🤖 OLS Model Confidence: <strong>@forecastResult.ConfidenceLevel</strong>
                        </span>
                        
                        <div class="btn-group btn-group-sm" role="group" aria-label="Forecast Horizon Selector">
                            <button type="button" class="btn btn-action btn-sm @(selectedForecastDays == 7 ? "active" : "")" @onclick="() => ChangeForecastHorizon(7)">7D</button>
                            <button type="button" class="btn btn-action btn-sm @(selectedForecastDays == 14 ? "active" : "")" @onclick="() => ChangeForecastHorizon(14)">14D</button>
                            <button type="button" class="btn btn-action btn-sm @(selectedForecastDays == 30 ? "active" : "")" @onclick="() => ChangeForecastHorizon(30)">30D</button>
                            <button type="button" class="btn btn-action btn-sm @(selectedForecastDays == 60 ? "active" : "")" @onclick="() => ChangeForecastHorizon(60)">60D</button>
                            <button type="button" class="btn btn-action btn-sm @(selectedForecastDays == 90 ? "active" : "")" @onclick="() => ChangeForecastHorizon(90)">90D</button>
                        </div>
                    </div>
                </div>

                <!-- Forecast Metrics Grid -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-light);">
                            <span class="text-secondary d-block" style="font-size: 0.75rem; font-weight: 600;">PROJECTED @selectedForecastDays-DAY SPEND</span>
                            <h4 class="mb-0 text-white font-weight-extrabold mt-1" style="font-size: 1.4rem;">
                                $@forecastResult.ProjectedNextMonthTotal.ToString("N2")
                            </h4>
                            <span class="text-secondary" style="font-size: 0.75rem;">estimated total</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-light);">
                            <span class="text-secondary d-block" style="font-size: 0.75rem; font-weight: 600;">DAILY BURN RATE</span>
                            <h4 class="mb-0 text-amber font-weight-extrabold mt-1" style="font-size: 1.4rem; color: #fbbf24;">
                                $@forecastResult.DailyBurnRate.ToString("N2")<span style="font-size: 0.75rem; font-weight: normal; color: var(--text-secondary);">/day</span>
                            </h4>
                            <span class="text-secondary" style="font-size: 0.75rem;">projected pace</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-light);">
                            <span class="text-secondary d-block" style="font-size: 0.75rem; font-weight: 600;">EXPECTED TRAJECTORY</span>
                            <h4 class="mb-0 font-weight-extrabold mt-1 @(forecastResult.TrendPercentage >= 0 ? "text-danger" : "text-success")" style="font-size: 1.4rem;">
                                @(forecastResult.TrendPercentage >= 0 ? "+" : "")@forecastResult.TrendPercentage.ToString("F1")%
                            </h4>
                            <span class="text-secondary" style="font-size: 0.75rem;">
                                @(forecastResult.TrendPercentage >= 0 ? "projected rise" : "projected savings")
                            </span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-light);">
                            <span class="text-secondary d-block" style="font-size: 0.75rem; font-weight: 600;">PRIMARY DRIVER</span>
                            <h4 class="mb-0 text-white font-weight-extrabold mt-1" style="font-size: 1.25rem;">
                                @forecastResult.TopGrowthCategoryIcon @forecastResult.TopGrowthCategoryName
                            </h4>
                            <span class="text-secondary" style="font-size: 0.75rem;">highest volume sector</span>
                        </div>
                    </div>
                </div>

                <!-- SVG Interactive Line Graph (Actual vs Projected Line) -->
                @{
                    var maxVal = (double)Math.Max(forecastResult.ProjectedNextMonthTotal, forecastResult.CurrentMonthSpend);
                    if (maxVal <= 0) maxVal = 1000;

                    int svgWidth = 700;
                    int svgHeight = 220;
                    int paddingX = 40;
                    int paddingY = 20;
                    double chartW = svgWidth - 2 * paddingX;
                    double chartH = svgHeight - 2 * paddingY;

                    // Build path data for Actual (Solid Cyan) vs Projected (Dashed Amber)
                    var pointsList = forecastResult.DailyPoints;
                    int count = pointsList.Count;

                    var actualPointsStr = new System.Text.StringBuilder();
                    var projectedPointsStr = new System.Text.StringBuilder();

                    for (int i = 0; i < count; i++)
                    {
                        var pt = pointsList[i];
                        double x = paddingX + (i / (double)(count - 1)) * chartW;
                        
                        double yActual = (paddingY + chartH) - ((double)pt.ActualCumulative / maxVal) * chartH;
                        double yProjected = (paddingY + chartH) - ((double)pt.ProjectedCumulative / maxVal) * chartH;

                        if (i == 0)
                        {
                            actualPointsStr.Append($"M {x.ToString("F1")} {yActual.ToString("F1")}");
                            projectedPointsStr.Append($"M {x.ToString("F1")} {yProjected.ToString("F1")}");
                        }
                        else
                        {
                            if (!pt.IsProjection)
                            {
                                actualPointsStr.Append($" L {x.ToString("F1")} {yActual.ToString("F1")}");
                            }
                            projectedPointsStr.Append($" L {x.ToString("F1")} {yProjected.ToString("F1")}");
                        }
                    }
                }

                <div class="p-3 rounded-3 mt-2" style="background: rgba(10, 14, 26, 0.6); border: 1px solid var(--border-light);">
                    <div class="d-flex justify-content-between align-items-center mb-2 px-2" style="font-size: 0.8rem;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-flex align-items-center gap-1 text-white">
                                <span style="display: inline-block; width: 16px; height: 3px; background-color: #818cf8;"></span> Actual Daily Spend
                            </span>
                            <span class="d-flex align-items-center gap-1 text-warning">
                                <span style="display: inline-block; width: 16px; height: 3px; background-color: #fbbf24; border-top: 2px dashed #fbbf24;"></span> @selectedForecastDays-Day Trend Projection
                            </span>
                        </div>
                        <span class="text-secondary">Day 1 ➔ Day @selectedForecastDays</span>
                    </div>

                    <div style="width: 100%; overflow-x: auto;">
                        <svg width="100%" height="220" viewBox="0 0 700 220" preserveAspectRatio="none" style="overflow: visible;">
                            <!-- Horizontal Grid Lines -->
                            <line x1="40" y1="20" x2="660" y2="20" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                            <line x1="40" y1="120" x2="660" y2="120" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                            <line x1="40" y1="200" x2="660" y2="200" stroke="rgba(255,255,255,0.1)" stroke-width="1" />

                            <!-- Projected Trend Line (Dashed Amber/Yellow) -->
                            <path d="@projectedPointsStr.ToString()" fill="none" stroke="#fbbf24" stroke-width="3" stroke-dasharray="6,4" style="filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.4));" />

                            <!-- Actual Spend Line (Solid Glowing Cyan) -->
                            <path d="@actualPointsStr.ToString()" fill="none" stroke="#818cf8" stroke-width="3.5" style="filter: drop-shadow(0 0 8px rgba(129, 140, 248, 0.5));" />
                        </svg>
                    </div>
                </div>
            </div>
        }

        <!-- AI Financial Advisor & Budget Recommendations Section -->
        @if (advisorReport != null)
        {
            <div class="glass-card mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
                    <div>
                        <h3 class="mb-1 text-white d-flex align-items-center gap-2">
                            <span>🤖</span> AI Financial Advisor & Budget Strategy
                        </h3>
                        <p class="text-secondary mb-0" style="font-size: 0.88rem;">
                            Actionable spending recommendations and trajectory optimization generated from regression data.
                        </p>
                    </div>

                    <!-- Health Score Badge -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 px-3 rounded-pill d-flex align-items-center gap-2" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-light);">
                            <span class="text-secondary" style="font-size: 0.8rem; font-weight: 600;">FINANCIAL HEALTH SCORE:</span>
                            <span class="badge rounded-pill px-3 py-1 font-weight-extrabold" style="background-color: @(advisorReport.HealthBadgeColor + "20"); color: @advisorReport.HealthBadgeColor; border: 1px solid @(advisorReport.HealthBadgeColor + "40"); font-size: 0.9rem;">
                                @advisorReport.HealthScore / 100 (@advisorReport.HealthLabel)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Recommendations Cards List -->
                <div class="row g-3">
                    @foreach (var tip in advisorReport.Tips)
                    {
                        <div class="col-12 col-md-6">
                            <div class="p-3.5 rounded-3 h-100 d-flex gap-3 align-items-start" style="background: rgba(255, 255, 255, 0.015); border: 1px solid var(--border-light);">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); font-size: 1.2rem;">
                                    @tip.Icon
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="text-white font-weight-bold" style="font-size: 0.95rem;">@tip.Title</span>
                                        <span class="badge" style="font-size: 0.68rem; background: rgba(255,255,255,0.05); color: var(--text-secondary); border: 1px solid var(--border-light);">
                                            @tip.Category
                                        </span>
                                    </div>
                                    <p class="text-secondary mb-0" style="font-size: 0.84rem; line-height: 1.45;">
                                        @tip.Message
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private decimal totalSpend = 0;
    private int selectedForecastDays = 30;
    private List<CategorySpend> categorySpends = new();
    private SpendForecasterService.ForecastResult? forecastResult;
    private FinancialAdvisorService.AdvisorReport? advisorReport;
    
    // SVG Donut Math Properties
    private const double Radius = 70;
    private const double Circumference = 2 * Math.PI * Radius; // ~439.82

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var year = DateTime.Today.Year;
            var month = DateTime.Today.Month;
            
            // Fetch total expenses for the month
            totalSpend = await ExpenseService.GetTotalExpensesForMonthAsync(year, month);
            
            // Fetch categorized spending breakdowns
            categorySpends = await ExpenseService.GetExpensesByCategoryForMonthAsync(year, month);

            // Fetch AI OLS Linear Regression Forecast for selected horizon
            forecastResult = await Forecaster.GenerateForecastAsync(selectedForecastDays);

            // Fetch AI Financial Advisor Recommendations Report
            if (forecastResult != null)
            {
                advisorReport = await Advisor.GenerateAdvisorReportAsync(forecastResult);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeForecastHorizon(int days)
    {
        selectedForecastDays = days;
        forecastResult = await Forecaster.GenerateForecastAsync(selectedForecastDays);
        if (forecastResult != null)
        {
            advisorReport = await Advisor.GenerateAdvisorReportAsync(forecastResult);
        }
    }
}
