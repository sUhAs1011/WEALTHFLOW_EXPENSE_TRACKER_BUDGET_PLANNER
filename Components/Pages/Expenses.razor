@page "/expenses"
@using C__Project.Models
@using C__Project.Services
@inject ExpenseService ExpenseService
@inject CategoryService CategoryService
@inject IJSRuntime JS

<PageTitle>WealthFlow — Expenses</PageTitle>

<div class="toast-container">
    @foreach (var toast in toasts)
    {
        <div class="toast-custom toast-@toast.Type">
            <span>@(toast.Type == "success" ? "✅" : toast.Type == "danger" ? "❌" : "⚠️")</span>
            <span class="toast-message">@toast.Message</span>
        </div>
    }
</div>

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1 text-white">Expenses</h1>
            <p class="text-secondary mb-0">Log, search, and manage your day-to-day transactions</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-secondary-custom d-flex align-items-center gap-2" @onclick="ExportToCsv">
                <span>📥</span> Export CSV
            </button>
            <button class="btn btn-primary-custom" @onclick="OpenAddModal">+ Log Expense</button>
        </div>
    </div>

    <!-- Main Content Area Grid -->
    <div class="row g-4">
        <!-- Left Column: Filters and Transactions Table -->
        <div class="col-12 col-lg-8">
            <!-- Filters Section -->
            <div class="glass-card mb-4">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label text-secondary" style="font-size: 0.85rem;">Search Description / Notes</label>
                        <input type="text" class="form-control" placeholder="Search..." @bind="filterSearch" @bind:event="oninput" @onkeyup="ApplyFilters" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label text-secondary" style="font-size: 0.85rem;">Category</label>
                        <select class="form-select" @bind="filterCategoryId" @bind:after="ApplyFilters">
                            <option value="@(0)">All Categories</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Icon @cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-sm-3 col-md-2.5">
                        <label class="form-label text-secondary" style="font-size: 0.85rem;">Start Date</label>
                        <input type="date" class="form-control" @bind="filterStartDate" @bind:after="ApplyFilters" />
                    </div>
                    <div class="col-6 col-sm-3 col-md-2.5">
                        <label class="form-label text-secondary" style="font-size: 0.85rem;">End Date</label>
                        <input type="date" class="form-control" @bind="filterEndDate" @bind:after="ApplyFilters" />
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <!-- Preset Buttons -->
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-action btn-sm py-1 px-3 @(activePreset == "this-month" ? "active" : "")" @onclick='() => SetDatePreset("this-month")'>This Month</button>
                        <button type="button" class="btn btn-action btn-sm py-1 px-3 @(activePreset == "last-30" ? "active" : "")" @onclick='() => SetDatePreset("last-30")'>Last 30 Days</button>
                        <button type="button" class="btn btn-action btn-sm py-1 px-3 @(activePreset == "this-year" ? "active" : "")" @onclick='() => SetDatePreset("this-year")'>This Year</button>
                        <button type="button" class="btn btn-action btn-sm py-1 px-3 @(activePreset == "all" ? "active" : "")" @onclick='() => SetDatePreset("all")'>All Time</button>
                    </div>
                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary-custom btn-sm py-1 px-3" @onclick="ResetFilters">Reset Filters</button>
                    </div>
                </div>
            </div>

            <!-- Expenses Table -->
            @if (isLoading)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (!filteredExpenses.Any())
            {
                <div class="glass-card text-center py-5">
                    <div class="mb-3" style="font-size: 3rem;">🔍</div>
                    <h4 class="text-white">No expenses matched your search</h4>
                    <p class="text-secondary">Try adjusting your filters or log a new transaction.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="transaction-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in filteredExpenses)
                            {
                                <tr>
                                    <td class="text-white">@expense.Date.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-white font-weight-bold">@expense.Description</span>
                                            @if (expense.IsRecurring)
                                            {
                                                <span class="badge d-flex align-items-center gap-1" style="font-size: 0.65rem; padding: 2px 6px; background-color: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3);" title="Recurring Subscription">
                                                    🔁 Auto
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(expense.Notes))
                                        {
                                            <div class="text-secondary" style="font-size: 0.8rem; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @expense.Notes
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="category-badge" style="background-color: @(expense.Category?.Color + "20"); color: @expense.Category?.Color; border: 1px solid @(expense.Category?.Color + "35")">
                                            @expense.Category?.Icon @expense.Category?.Name
                                        </span>
                                    </td>
                                    <td class="text-white text-end font-weight-bold" style="font-size: 1.05rem;">
                                        -$@expense.Amount.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-action btn-edit" @onclick="() => OpenEditModal(expense)">Edit</button>
                                            <button class="btn btn-action btn-delete" @onclick="() => DeleteExpense(expense.Id)">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Right Column: Subscriptions Commitments Panel -->
        <div class="col-12 col-lg-4">
            <div class="glass-card">
                <h3 class="mb-4 text-white d-flex align-items-center gap-2">
                    <span>🔁</span> Subscriptions
                </h3>
                
                <div class="p-3 rounded-3 mb-4 text-white text-center" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.08) 0%, rgba(245, 158, 11, 0.03) 100%); border: 1px solid rgba(239, 68, 68, 0.15);">
                    <span class="text-secondary d-block" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em;">TOTAL MONTHLY COMMITMENT</span>
                    <h2 class="mb-0 text-danger font-weight-extrabold mt-2" style="font-size: 1.8rem; letter-spacing: -0.02em; text-shadow: 0 0 15px rgba(239, 68, 68, 0.15);">
                        $@totalSubscriptionsCost.ToString("N2")<span style="font-size: 0.85rem; font-weight: normal; color: var(--text-secondary);">/mo</span>
                    </h2>
                </div>
                
                @if (!activeSubscriptions.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3" style="font-size: 2.2rem;">🔁</div>
                        <h5 class="text-white">No active subscriptions</h5>
                        <p class="text-secondary" style="font-size: 0.85rem; line-height: 1.4;">Mark expenses as "Recurring" when logging them to track your committed automated expenses here.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var sub in activeSubscriptions)
                        {
                            <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background: rgba(255, 255, 255, 0.015); border: 1px solid var(--border-light);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; background-color: @(sub.Category?.Color + "15"); color: @sub.Category?.Color; font-size: 1rem; border: 1px solid @(sub.Category?.Color + "25");">
                                        @sub.Category?.Icon
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-white font-weight-bold" style="font-size: 0.9rem;">@sub.Description</h6>
                                        <span class="text-secondary" style="font-size: 0.72rem;">Last billed: @sub.Date.ToString("MMM dd")</span>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="text-white font-weight-bold" style="font-size: 0.95rem;">-$@sub.Amount.ToString("N2")</span>
                                    <span class="text-secondary d-block" style="font-size: 0.7rem;">monthly</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Expense Modal -->
@if (isModalOpen)
{
    <div class="modal-backdrop-custom">
        <div class="modal-content-custom glass-card p-0">
            <div class="p-4 border-bottom border-secondary d-flex justify-content-between align-items-center" style="background: rgba(255, 255, 255, 0.02);">
                <h4 class="mb-0 text-white">@(editingExpense.Id == 0 ? "Log New Expense" : "Edit Expense")</h4>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>
            
            <EditForm Model="editingExpense" OnValidSubmit="SaveExpense">
                <DataAnnotationsValidator />
                
                <div class="p-4 d-flex flex-column gap-3">
                    <!-- Description -->
                    <div>
                        <label class="form-label">Description</label>
                        <InputText @bind-Value="editingExpense.Description" class="form-control" placeholder="e.g. Weekly Groceries" />
                        <ValidationMessage For="() => editingExpense.Description" class="text-danger mt-1" style="font-size: 0.8rem;" />
                    </div>

                    <div class="row g-3">
                        <!-- Amount -->
                        <div class="col-6">
                            <label class="form-label">Amount ($)</label>
                            <InputNumber @bind-Value="editingExpense.Amount" class="form-control" placeholder="0.00" />
                            <ValidationMessage For="() => editingExpense.Amount" class="text-danger mt-1" style="font-size: 0.8rem;" />
                        </div>
                        
                        <!-- Date -->
                        <div class="col-6">
                            <label class="form-label">Date</label>
                            <InputDate @bind-Value="editingExpense.Date" class="form-control" />
                            <ValidationMessage For="() => editingExpense.Date" class="text-danger mt-1" style="font-size: 0.8rem;" />
                        </div>
                    </div>

                    <!-- Category selection -->
                    <div>
                        <label class="form-label">Category</label>
                        <InputSelect @bind-Value="editingExpense.CategoryId" class="form-select">
                            <option value="@(0)" disabled>Select Category</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Icon @cat.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => editingExpense.CategoryId" class="text-danger mt-1" style="font-size: 0.8rem;" />
                    </div>

                    <!-- Recurring Toggle -->
                    <div class="form-check form-switch mt-1">
                        <InputCheckbox @bind-Value="editingExpense.IsRecurring" class="form-check-input" id="isRecurring" />
                        <label class="form-check-label text-white ms-2" for="isRecurring" style="font-size: 0.9rem;">Mark as Recurring Subscription</label>
                    </div>

                    <!-- Notes -->
                    <div>
                        <label class="form-label">Notes (Optional)</label>
                        <InputTextArea @bind-Value="editingExpense.Notes" class="form-control" rows="3" placeholder="Add additional notes here..." />
                        <ValidationMessage For="() => editingExpense.Notes" class="text-danger mt-1" style="font-size: 0.8rem;" />
                    </div>
                </div>

                <div class="p-4 border-top border-secondary d-flex justify-content-end gap-2" style="background: rgba(255, 255, 255, 0.02);">
                    <button type="button" class="btn btn-secondary-custom" @onclick="CloseModal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Export CSV Filename Prompt Modal -->
@if (isExportModalOpen)
{
    <div class="modal-backdrop-custom d-flex align-items-center justify-content-center">
        <div class="modal-content-custom glass-card p-0" style="max-width: 400px; border: 1px solid var(--border-light);">
            <div class="p-4 border-bottom border-secondary d-flex justify-content-between align-items-center" style="background: rgba(255, 255, 255, 0.02);">
                <h4 class="mb-0 text-white font-weight-bold">Export to CSV</h4>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseExportModal"></button>
            </div>
            
            <div class="p-4 d-flex flex-column gap-3">
                <div>
                    <label class="form-label text-secondary" style="font-size: 0.85rem; font-weight: 600;">Specify Filename</label>
                    <input type="text" class="form-control bg-dark border-secondary text-white" @bind="exportFileName" placeholder="e.g. My_Expenses" />
                    <span class="text-secondary mt-1 d-block" style="font-size: 0.72rem;">File extension (.csv) will be added automatically.</span>
                </div>
            </div>
            
            <div class="p-4 border-top border-secondary d-flex justify-content-end gap-2" style="background: rgba(255, 255, 255, 0.02);">
                <button type="button" class="btn btn-secondary-custom" @onclick="CloseExportModal">Cancel</button>
                <button type="button" class="btn btn-primary-custom px-4" @onclick="ConfirmExportToCsv">Download</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isModalOpen = false;
    private bool isExportModalOpen = false;
    private string exportFileName = "";
    private List<Expense> allExpenses = new();
    private List<Expense> filteredExpenses = new();
    private List<Category> categories = new();
    private List<Expense> activeSubscriptions = new();
    private decimal totalSubscriptionsCost = 0;

    // Filters Model
    private string filterSearch = "";
    private int filterCategoryId = 0;
    private DateTime? filterStartDate;
    private DateTime? filterEndDate;
    private string activePreset = "all";

    // Editing State
    private Expense editingExpense = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            categories = await CategoryService.GetCategoriesAsync();
            allExpenses = await ExpenseService.GetExpensesAsync();
            ApplyFilters();
            UpdateSubscriptionsList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading expenses: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var query = allExpenses.AsQueryable();

        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            query = query.Where(e => e.Description.Contains(filterSearch, StringComparison.OrdinalIgnoreCase) || 
                                     (e.Notes != null && e.Notes.Contains(filterSearch, StringComparison.OrdinalIgnoreCase)));
        }

        if (filterCategoryId > 0)
        {
            query = query.Where(e => e.CategoryId == filterCategoryId);
        }

        if (filterStartDate.HasValue)
        {
            query = query.Where(e => e.Date >= filterStartDate.Value);
        }

        if (filterEndDate.HasValue)
        {
            query = query.Where(e => e.Date <= filterEndDate.Value);
        }

        filteredExpenses = query.ToList();
    }

    private void UpdateSubscriptionsList()
    {
        activeSubscriptions = allExpenses
            .Where(e => e.IsRecurring)
            .GroupBy(e => e.Description.Trim().ToLower())
            .Select(g => g.OrderByDescending(e => e.Date).First())
            .OrderByDescending(e => e.Amount)
            .ToList();
            
        totalSubscriptionsCost = activeSubscriptions.Sum(s => s.Amount);
    }

    // Toast Notifications State
    private List<ToastMessage> toasts = new();

    private async void ShowToast(string message, string type = "success")
    {
        var toast = new ToastMessage { Message = message, Type = type };
        toasts.Add(toast);
        StateHasChanged();
        
        // Auto-dismiss after 3.5 seconds safely on the UI synchronization context
        await Task.Delay(3500);
        
        toasts.Remove(toast);
        StateHasChanged();
    }

    private class ToastMessage
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Message { get; set; } = "";
        public string Type { get; set; } = "success";
    }

    private void ResetFilters()
    {
        filterSearch = "";
        filterCategoryId = 0;
        filterStartDate = null;
        filterEndDate = null;
        activePreset = "all";
        ApplyFilters();
    }

    private void SetDatePreset(string preset)
    {
        activePreset = preset;
        var today = DateTime.Today;
        
        switch (preset)
        {
            case "this-month":
                filterStartDate = new DateTime(today.Year, today.Month, 1);
                filterEndDate = new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
                break;
            case "last-30":
                filterStartDate = today.AddDays(-30);
                filterEndDate = today;
                break;
            case "this-year":
                filterStartDate = new DateTime(today.Year, 1, 1);
                filterEndDate = new DateTime(today.Year, 12, 31);
                break;
            case "all":
            default:
                filterStartDate = null;
                filterEndDate = null;
                break;
        }
        
        ApplyFilters();
    }

    private void OpenAddModal()
    {
        editingExpense = new Expense 
        { 
            Date = DateTime.Today,
            CategoryId = categories.FirstOrDefault()?.Id ?? 0,
            IsRecurring = false
        };
        isModalOpen = true;
    }

    private void OpenEditModal(Expense expense)
    {
        editingExpense = new Expense
        {
            Id = expense.Id,
            Description = expense.Description,
            Amount = expense.Amount,
            Date = expense.Date,
            CategoryId = expense.CategoryId,
            Notes = expense.Notes,
            IsRecurring = expense.IsRecurring
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveExpense()
    {
        if (editingExpense.CategoryId <= 0)
        {
            return;
        }

        var isNew = editingExpense.Id == 0;
        bool result = await ExpenseService.SaveExpenseAsync(editingExpense);
        if (result)
        {
            isModalOpen = false;
            ShowToast(isNew ? "Transaction logged successfully!" : "Transaction updated successfully!");
            await LoadData();
        }
        else
        {
            ShowToast("Failed to save transaction.", "danger");
        }
    }

    private async Task DeleteExpense(int id)
    {
        bool confirmed = true; // For Blazor Server, standard JS confirm or a modal can be used. We'll execute directly.
        if (confirmed)
        {
            bool result = await ExpenseService.DeleteExpenseAsync(id);
            if (result)
            {
                ShowToast("Transaction deleted successfully.", "warning");
                await LoadData();
            }
            else
            {
                ShowToast("Failed to delete transaction.", "danger");
            }
        }
    }

    private void ExportToCsv()
    {
        if (filteredExpenses == null || !filteredExpenses.Any())
        {
            ShowToast("No transactions found to export.", "warning");
            return;
        }

        // Set default filename using the current month and year
        exportFileName = $"WealthFlow_Expenses_{DateTime.Today:MMMM_yyyy}";
        isExportModalOpen = true;
    }

    private void CloseExportModal()
    {
        isExportModalOpen = false;
    }

    private async Task ConfirmExportToCsv()
    {
        isExportModalOpen = false;

        var finalFileName = string.IsNullOrWhiteSpace(exportFileName) 
            ? $"WealthFlow_Expenses_{DateTime.Today:MMMM_yyyy}" 
            : exportFileName.Trim();
            
        if (finalFileName.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            finalFileName = finalFileName.Substring(0, finalFileName.Length - 4);
        }
        
        finalFileName += ".csv";

        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Date,Category,Description,Amount,Notes");

        foreach (var expense in filteredExpenses)
        {
            var dateStr = expense.Date.ToString("yyyy-MM-dd");
            var categoryStr = CleanCsvField(expense.Category?.Name ?? "Uncategorized");
            var descStr = CleanCsvField(expense.Description);
            var amountStr = expense.Amount.ToString("F2");
            var notesStr = CleanCsvField(expense.Notes ?? "");

            csv.AppendLine($"{dateStr},{categoryStr},{descStr},{amountStr},{notesStr}");
        }

        await JS.InvokeVoidAsync("downloadFileFromText", finalFileName, csv.ToString());
        ShowToast($"Successfully exported {filteredExpenses.Count} transaction(s) to CSV!");
    }

    private string CleanCsvField(string field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        if (field.Contains(",") || field.Contains("\"") || field.Contains("\n") || field.Contains("\r"))
        {
            return $"\"{field.Replace("\"", "\"\"")}\"";
        }
        return field;
    }
}
